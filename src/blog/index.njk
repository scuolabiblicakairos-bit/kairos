---
layout: layouts/base.njk
title: Blog
permalink: /blog/
---
<section class="elenco-intro">
  <h1>Blog</h1>
  <p>Articoli e approfondimenti dalla Scuola Biblica Kairos.</p>
  {% if collections.categorie.length %}
  <div style="margin-top:22px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center">
    {% for cat in collections.categorie %}<a class="chip" href="{{ ('/categoria/' + cat.fileSlug + '/') | url }}">{{ cat.data.title }}</a>{% endfor %}
  </div>
  {% endif %}
</section>
{% if collections.posts.length %}
<section class="elenco-post">
  {% for p in collections.posts %}{% include "partials/post-card.njk" %}{% endfor %}
</section>
{% else %}
<p class="vuoto">Nessun articolo pubblicato per ora.</p>
{% endif %}
