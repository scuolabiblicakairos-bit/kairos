{% set liv = c.data.livello | lower %}
<div class="corso-card card-{{ liv }}">
  <div class="corso-band band-{{ liv }}"></div>
  <div class="corso-body">
    <div class="corso-header">
      <span class="corso-livello livello-{{ liv }}">Livello {{ c.data.livello }}</span>
      <span class="corso-badge {% if c.data.stato == 'Disponibile' %}badge-disponibile{% else %}badge-presto{% endif %}">{{ c.data.stato }}</span>
    </div>
    <div class="corso-icona icona-{{ liv }}">
      {% if liv == 'basic' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      {% elif liv == 'intermedio' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M7 7h10"/></svg>
      {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>{% endif %}
    </div>
    <h2 class="corso-titolo">{{ c.data.title }}</h2>
    <p class="corso-desc">{{ c.data.descrizione }}</p>
    <div class="corso-divider"></div>
    <ul class="corso-moduli">
      {% for m in c.data.moduli %}<li><span class="dot dot-{{ liv }}"></span>{{ m }}</li>
      {% endfor %}
    </ul>
    <div class="corso-meta">
      <span class="corso-meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> {{ c.data.lezioni }} lezioni</span>
      <span class="corso-meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg> Materiale incluso</span>
    </div>
    <a href="{{ c.url | url }}" class="corso-card-cta cta-{{ liv }}">{{ c.data.cta or 'Scopri il corso →' }}</a>
  </div>
</div>
